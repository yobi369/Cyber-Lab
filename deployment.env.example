# Copy into your deployment secret manager/environment; never commit populated values.
SENTINEL_ENV=production
SENTINEL_BIND=127.0.0.1
SENTINEL_PORT=8765
SENTINEL_PUBLIC_ORIGIN=https://sentinel.example.com
SENTINEL_TLS_CERT=/run/secrets/tls.crt
SENTINEL_TLS_KEY=/run/secrets/tls.key
SENTINEL_COOKIE_SECURE=1

SENTINEL_DB=/var/lib/sentinel/sentinel.sqlite3
SENTINEL_DB_ENCRYPTION=1
SENTINEL_DB_KEY=<64-hex-character-secret>

SENTINEL_MFA_ENCRYPTION_KEY=<64-hex-character-secret>
SENTINEL_REQUIRE_MFA=1

SENTINEL_OIDC_ISSUER=https://identity.example.com
SENTINEL_OIDC_CLIENT_ID=<client-id>
SENTINEL_OIDC_CLIENT_SECRET=<client-secret>
SENTINEL_OIDC_REDIRECT_URI=https://sentinel.example.com/auth/oidc/callback
SENTINEL_OIDC_TENANT_ID=<optional-tenant-id>
SENTINEL_OIDC_REQUIRE_MFA=1
SENTINEL_REQUIRE_OIDC=1

SENTINEL_AUDIT_HMAC_KEY=<at-least-32-character-secret>
SENTINEL_AUDIT_KEY_ID=audit-v1
SENTINEL_AUDIT_S3_BUCKET=<object-lock-enabled-bucket>
SENTINEL_AUDIT_RETENTION_DAYS=365
SENTINEL_AUDIT_ARCHIVE_INTERVAL_SECONDS=300
SENTINEL_REQUIRE_EXTERNAL_AUDIT=1

# Set only when using AES-256-GCM backup wrapping; keep separate from DB key.
SENTINEL_BACKUP_KEY=<64-hex-character-secret-managed-outside-this-file>
